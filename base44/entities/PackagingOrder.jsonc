{
  "name": "PackagingOrder",
  "type": "object",
  "properties": {
    "move_request_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "packaging_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    },
    "include_packing_service": {
      "type": "boolean",
      "default": false
    },
    "packing_service_price": {
      "type": "number",
      "default": 0
    },
    "include_shuttle_service": {
      "type": "boolean",
      "default": false
    },
    "shuttle_service_price": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    }
  },
  "required": [
    "move_request_id"
  ]
}