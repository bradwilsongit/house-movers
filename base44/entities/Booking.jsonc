{
  "name": "Booking",
  "type": "object",
  "properties": {
    "move_request_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_supplier_acceptance",
        "pending_payment",
        "confirmed",
        "driver_assigned",
        "on_route",
        "arrived",
        "loading",
        "in_transit",
        "unloading",
        "completed",
        "cancelled"
      ],
      "default": "pending_supplier_acceptance"
    },
    "booking_reference": {
      "type": "string"
    },
    "move_date": {
      "type": "string",
      "format": "date"
    },
    "time_window": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_phone": {
      "type": "string"
    },
    "vehicle_details": {
      "type": "string"
    },
    "distance_km": {
      "type": "number"
    },
    "supplier_base_price": {
      "type": "number"
    },
    "commission_rate": {
      "type": "number"
    },
    "commission_amount": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "payfast_payment_id": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "supplier_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "arrived_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancellation_reason": {
      "type": "string"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "split_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether split payment was used for this booking"
    },
    "split_receiver_merchant_id": {
      "type": "string",
      "description": "Supplier PayFast merchant ID used for split (locked at checkout)"
    },
    "split_percentage": {
      "type": "number",
      "description": "Commission % locked at checkout time for split payment"
    },
    "split_setup_payload": {
      "type": "string",
      "description": "The exact setup JSON string sent to PayFast (for audit/debug)"
    }
  },
  "required": [
    "move_request_id",
    "quote_id",
    "supplier_id",
    "customer_id"
  ]
}